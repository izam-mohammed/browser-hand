{
  "name": "browser-hand-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@mozilla/readability": "0.6.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
